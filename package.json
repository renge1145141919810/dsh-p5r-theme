{
  "name": "dsh-theme-p5r",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Persona 5 Royal inspired theme for DeepSeek Harness: ink black, phantom red, newspaper paper, halftone dots and slanted print geometry.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "persona",
    "p5r",
    "client"
  ],
  "license": "MIT",
  "author": "renge1145141919810",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renge1145141919810/dsh-p5r-theme.git"
  },
  "homepage": "https://github.com/renge1145141919810/dsh-p5r-theme#readme",
  "bugs": {
    "url": "https://github.com/renge1145141919810/dsh-p5r-theme/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
